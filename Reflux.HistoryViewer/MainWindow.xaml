<Window x:Class="Reflux.HistoryViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reflux.HistoryViewer"
        xmlns:vm="clr-namespace:Reflux.HistoryViewer.ViewModels"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Reflux History Viewer" Width="1280" Height="800" MinWidth="960" MinHeight="600">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="GridBase" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6E6E6" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="False" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="フォルダを開く(_O)..." Command="{Binding OpenFolderCommand}" />
                <MenuItem Header="過去データを取り込む(_I)..." Command="{Binding ImportSessionsCommand}" ToolTip="sessions/*.json（savejson の出力）を viewer.db に取り込みます" />
                <MenuItem Header="再取り込み(_R)" InputGestureText="F5" Command="{Binding ReimportCommand}" />
                <MenuItem Header="全件取り込み直し(_A)" Command="{Binding RebuildCommand}" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="曲一覧(_S)" Command="{Binding ShowSongsCommand}" />
                <MenuItem Header="日別サマリ(_D)" Command="{Binding ShowDailyCommand}" />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="DB の場所を開く(_B)" Click="OpenDbFolder_Click" />
                <MenuItem Header="バージョン情報(_A)" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding WatchedFile, StringFormat=監視中: {0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding LastImportText, StringFormat=最終取り込み: {0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SkippedLines, StringFormat=読み飛ばし: {0} 行}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="100" Height="12" Margin="0,0,6,0" IsIndeterminate="True" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ProgressText}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#444444" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="曲名" Style="{StaticResource FilterLabel}" Margin="0,0,4,0" />
                <TextBox x:Name="SearchBox" Width="240" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="レベル" Style="{StaticResource FilterLabel}" />
                <ComboBox Width="70" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" DisplayMemberPath="Label" />
                <TextBlock Text="SP/DP" Style="{StaticResource FilterLabel}" />
                <ComboBox Width="80" ItemsSource="{Binding Sides}" SelectedItem="{Binding SelectedSide}" DisplayMemberPath="Label" />
                <TextBlock Text="難易度" Style="{StaticResource FilterLabel}" />
                <ComboBox Width="130" ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty}" DisplayMemberPath="Label" />
                <TextBlock Text="ランプ" Style="{StaticResource FilterLabel}" />
                <ComboBox Width="160" ItemsSource="{Binding Lamps}" SelectedItem="{Binding SelectedLamp}" DisplayMemberPath="Label" />
                <TextBlock Text="期間" Style="{StaticResource FilterLabel}" />
                <ComboBox Width="90" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" />
                <Button Content="クリア" Margin="12,0,0,0" Padding="10,2" Command="{Binding ClearFiltersCommand}" />
                <TextBlock Style="{StaticResource FilterLabel}" Foreground="#666666" Text="{Binding ChartCount, StringFormat={}{0} 譜面}" />
            </StackPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}" BorderThickness="0,1,0,0" Padding="0">
            <TabItem Header="曲一覧">
                <Grid x:Name="SplitGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="UpperRow" Height="42*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="LowerRow" Height="58*" MinHeight="200" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ChartsGrid" Grid.Row="0" Style="{StaticResource GridBase}"
                              ItemsSource="{Binding Charts}" SelectedItem="{Binding SelectedChart}" Sorting="ChartsGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="曲名" Binding="{Binding Title}" Width="*" SortMemberPath="Title" />
                            <DataGridTextColumn Header="難易度" Binding="{Binding Difficulty}" Width="70" SortMemberPath="Difficulty" ElementStyle="{StaticResource CenterCell}" />
                            <DataGridTextColumn Header="レベル" Binding="{Binding Level}" Width="60" SortMemberPath="Level" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="プレー回数" Binding="{Binding PlayCount}" Width="85" SortMemberPath="PlayCount" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="自己ベストEX" Binding="{Binding BestExScore}" Width="100" SortMemberPath="BestExScore" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="自己ベストランプ" Binding="{Binding BestLampText}" Width="125" SortMemberPath="BestLampRank" />
                            <DataGridTextColumn Header="最小BP" Binding="{Binding MinMissCount}" Width="65" SortMemberPath="MinMissCount" ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn x:Name="LastPlayedColumn" Header="最終プレー" Binding="{Binding LastPlayedLocal, StringFormat=yyyy/MM/dd HH:mm}" Width="140" SortMemberPath="LastPlayedAt" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#DDDDDD"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" DragCompleted="Splitter_DragCompleted" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="10,8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" MinHeight="58">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,3" MinWidth="80"
                                              IsChecked="{Binding NewestFirst}" Content="{Binding OrderLabel}" ToolTip="プレー一覧の並び順を切り替えます" />
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Foreground="#888888" Text="上の一覧から曲を選択してください"
                                               Visibility="{Binding HasDetail, Converter={StaticResource InverseBoolToVis}}" />
                                    <StackPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding DetailChart.Title}" />
                                            <TextBlock Margin="12,0,0,2" VerticalAlignment="Bottom" Foreground="#666666" Text="{Binding DetailChart.Artist}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Style="{StaticResource HeaderLabel}" Text="難易度" />
                                            <TextBlock Style="{StaticResource HeaderValue}" Text="{Binding DetailChart.Difficulty}" />
                                            <TextBlock Style="{StaticResource HeaderLabel}" Text="レベル" />
                                            <TextBlock Style="{StaticResource HeaderValue}" Text="{Binding DetailChart.Level}" />
                                            <TextBlock Style="{StaticResource HeaderLabel}" Text="ノーツ" />
                                            <TextBlock Style="{StaticResource HeaderValue}" Text="{Binding DetailChart.TotalNotes}" />
                                            <TextBlock Style="{StaticResource HeaderLabel}" Text="プレー回数" />
                                            <TextBlock Style="{StaticResource HeaderValue}" Text="{Binding DetailChart.PlayCount}" />
                                            <TextBlock Style="{StaticResource HeaderLabel}" Text="自己ベスト EX" />
                                            <TextBlock Style="{StaticResource HeaderValue}" Text="{Binding DetailChart.BestExScore}" />
                                            <TextBlock Style="{StaticResource HeaderLabel}" Text="ランプ" />
                                            <TextBlock Style="{StaticResource HeaderValue}" Text="{Binding DetailChart.BestLampText}" />
                                            <TextBlock Style="{StaticResource HeaderLabel}" Text="BP" />
                                            <TextBlock Style="{StaticResource HeaderValue}" Text="{Binding DetailChart.MinMissCount}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <sp:WpfPlot x:Name="ExPlot" Grid.Row="0" Margin="2" />
                                <sp:WpfPlot x:Name="BpPlot" Grid.Row="1" Margin="2" />
                            </Grid>
                            <DataGrid x:Name="PlaysGrid" Grid.Column="1" Style="{StaticResource GridBase}" ItemsSource="{Binding Plays}"
                                      FrozenColumnCount="1" HorizontalScrollBarVisibility="Auto" BorderThickness="1,0,0,0" BorderBrush="#DDDDDD">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataAvailable}" Value="False">
                                                <Setter Property="Background" Value="#F2F2F2" />
                                                <Setter Property="Foreground" Value="#8A8A8A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                <Setter Property="Background" Value="#FFF3B8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日時" Binding="{Binding RecordedAtLocal, StringFormat=yyyy/MM/dd HH:mm:ss}" Width="140" />
                                    <DataGridTextColumn Header="" Binding="{Binding UnavailableMark}" Width="26" ElementStyle="{StaticResource CenterCell}" />
                                    <DataGridTextColumn Header="EX" Binding="{Binding ExScore}" Width="60" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="グレード" Binding="{Binding Grade}" Width="65" ElementStyle="{StaticResource CenterCell}" />
                                    <DataGridTextColumn Header="ランプ" Binding="{Binding LampText}" Width="115" />
                                    <DataGridTextColumn Header="BP" Binding="{Binding MissCount}" Width="50" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="ゲージ" Binding="{Binding GaugeType}" Width="90" />
                                    <DataGridTextColumn Header="ゲージ%" Binding="{Binding GaugePercent}" Width="65" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="配置" Binding="{Binding StyleText}" Width="130" />
                                    <DataGridTextColumn Header="アシスト" Binding="{Binding Assist}" Width="105" />
                                    <DataGridTextColumn Header="SUD+/HID+" Binding="{Binding Range}" Width="95" />
                                    <DataGridTextColumn Header="FLIP" Binding="{Binding FlipMark}" Width="45" ElementStyle="{StaticResource CenterCell}" />
                                    <DataGridTextColumn Header="BATTLE" Binding="{Binding BattleMark}" Width="58" ElementStyle="{StaticResource CenterCell}" />
                                    <DataGridTextColumn Header="H-RAN" Binding="{Binding HranMark}" Width="55" ElementStyle="{StaticResource CenterCell}" />
                                    <DataGridTextColumn Header="PG" Binding="{Binding PGreat}" Width="55" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="GR" Binding="{Binding Great}" Width="55" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="GD" Binding="{Binding Good}" Width="50" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="BD" Binding="{Binding Bad}" Width="50" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="PR" Binding="{Binding Poor}" Width="50" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="CB" Binding="{Binding ComboBreak}" Width="50" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="FAST" Binding="{Binding Fast}" Width="55" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="SLOW" Binding="{Binding Slow}" Width="55" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="途中終了" Binding="{Binding PrematureMark}" Width="65" ElementStyle="{StaticResource CenterCell}" />
                                    <DataGridTextColumn Header="サイド" Binding="{Binding PlaySide}" Width="50" ElementStyle="{StaticResource CenterCell}" />
                                    <DataGridTextColumn Header="出典" Binding="{Binding SourceText}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="日別サマリ">
                <DataGrid Style="{StaticResource GridBase}" ItemsSource="{Binding Daily}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日付" Binding="{Binding Day}" Width="120" />
                        <DataGridTextColumn Header="プレー数" Binding="{Binding Plays}" Width="90" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="自己ベスト更新" Binding="{Binding NewBests}" Width="115" ElementStyle="{StaticResource RightCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
