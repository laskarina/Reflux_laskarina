<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Reflux.HistoryViewer</RootNamespace>
    <AssemblyName>Reflux.HistoryViewer</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon>../Reflux/Resources/icon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Lets the project build (and the XAML compile) on non-Windows hosts; no effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Single-file publish: bundle SQLite / SkiaSharp native libraries into the exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.0.56" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Reflux.HistoryViewer.Core/Reflux.HistoryViewer.Core.csproj" />
  </ItemGroup>

</Project>
